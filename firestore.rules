rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }
    function isSelf(uid) {
      return request.auth.uid == uid;
    }
    function isAdmin() {
      return isAuth() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function isGuide() {
      return isAuth() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'guide';
    }

    // ── Users ─────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isAuth();
      allow write: if isAuth() && (isSelf(userId) || isAdmin());
    }

    // ── Username claims (atomic uniqueness enforcement) ───────────────────────
    match /usernames/{handle} {
      allow read: if isAuth();
      // Only the declared owner can create their own claim
      allow create: if isAuth() && request.resource.data.uid == request.auth.uid;
      // Only the declared owner can release their claim
      allow delete: if isAuth() && resource.data.uid == request.auth.uid;
      allow update: if false; // claims are immutable — delete + create to change
    }

    // ── Places (landmark data — read-only for users) ──────────────────────────
    match /places/{placeId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // ── Tours ─────────────────────────────────────────────────────────────────
    match /tours/{tourId} {
      allow read: if isAuth();
      allow create: if isGuide() &&
        request.resource.data.guideId == request.auth.uid;
      allow update, delete: if isAuth() && (
        resource.data.guideId == request.auth.uid || isAdmin()
      );
    }

    // ── Bookings ──────────────────────────────────────────────────────────────
    match /bookings/{bookingId} {
      allow read: if isAuth() && (
        resource.data.userId  == request.auth.uid ||
        resource.data.guideId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuth() &&
        request.resource.data.userId == request.auth.uid;
      // Tourist can cancel; guide can confirm/check-in; admin can do anything
      allow update: if isAuth() && (
        resource.data.userId  == request.auth.uid ||
        resource.data.guideId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if false;
    }

    // ── Community Posts ───────────────────────────────────────────────────────
    match /community_posts/{postId} {
      allow read: if isAuth();
      allow create: if isAuth() &&
        request.resource.data.userId == request.auth.uid;
      // Any authenticated user can update (needed for likes/commentsCount increments)
      allow update: if isAuth();
      allow delete: if isAuth() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );

      match /comments/{commentId} {
        allow read: if isAuth();
        allow create: if isAuth() &&
          request.resource.data.userId == request.auth.uid;
        allow update: if isAuth();
        allow delete: if isAuth() && (
          resource.data.userId == request.auth.uid || isAdmin()
        );
      }
    }

    // ── Reviews ───────────────────────────────────────────────────────────────
    match /reviews/{reviewId} {
      allow read: if isAuth();
      // Tourist writes their own review; touristId must match their uid
      allow create: if isAuth() &&
        request.resource.data.touristId == request.auth.uid;
      // Reviews are immutable once written
      allow update, delete: if false;
    }

    // ── Events (read-only for authenticated users) ────────────────────────────
    match /events/{eventId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // ── Reports ───────────────────────────────────────────────────────────────
    match /reports/{reportId} {
      allow create: if isAuth();
      allow read, update, delete: if isAdmin();
    }

    // ── Admin requests (language certifications, etc.) ────────────────────────
    match /admin_requests/{requestId} {
      allow create: if isGuide();
      allow read, update, delete: if isAdmin();
    }

    // ── Recommendation engine ─────────────────────────────────────────────────
    // Signals written only by Cloud Functions (admin SDK bypasses rules).
    // User may read their own log; admin may read all.
    match /users/{userId}/signals/{sigId} {
      allow read: if isAuth() && (isSelf(userId) || isAdmin());
      allow write: if false;
    }

    // Aggregate place affinity — authenticated read, server-only write.
    match /place_affinity/{placeId} {
      allow read: if isAuth();
      allow write: if false;
    }

    // Item-item neighbor map (collaborative filtering) — server-only write.
    match /place_neighbors/{placeId} {
      allow read: if isAuth();
      allow write: if false;
    }

    // Cold-start country priors — server-only write.
    match /country_priors/{countryCode} {
      allow read: if isAuth();
      allow write: if false;
    }

    // ── Notifications (per-user subcollection) ────────────────────────────────
    match /users/{userId}/notifications/{notificationId} {
      allow read: if isAuth() && isSelf(userId);
      // Any authenticated user can push a notification to another user
      // (needed for like/comment/booking triggers from the client)
      allow write: if isAuth();
    }

    // ── Solo plans (per-user subcollection) ───────────────────────────────────
    // Users can fully manage their own plans; no one else can touch them.
    match /users/{userId}/solo_plans/{planId} {
      allow read, write: if isAuth() && isSelf(userId);
    }

    // ── Places API photo cache ────────────────────────────────────────────────
    // Cached by authenticated clients; one doc per curated trip ID (slug).
    match /place_photos/{tripId} {
      allow read: if isAuth();
      allow write: if isAuth();
    }

    // ── AI story cache (per-landmark slug, 90-day TTL) ────────────────────────
    match /place_stories/{slug} {
      allow read: if isAuth();
      allow write: if isAuth();
    }

    // ── Rate limits (Cloud Functions internal — server SDK bypasses rules) ─────
    // Client never reads or writes this; deny everything to be explicit.
    match /_rate_limits/{docId} {
      allow read, write: if false;
    }
  }
}
