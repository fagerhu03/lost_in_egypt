rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Default deny everything
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Profile images: anyone can read; user can only write their own
    match /profile_images/{imageId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        imageId.matches('profile_' + request.auth.uid + '.*');
    }

    // Guide application documents: user can only read/write their own folder
    match /guide_applications/{userId}/{document=**} {
      allow read:  if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Tour images: path is tours/{guideId}/{tourId}/{file}
    // Only the guide who owns the folder (guideId == uid) can write
    match /tours/{guideId}/{allPaths=**} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == guideId;
    }

    // Community post images: path is post_images/{timestamp_filename}
    // Any authenticated user can upload (filename has no uid — cannot scope further
    // without changing the upload path in firebase_community_repository.dart)
    match /post_images/{fileName} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
